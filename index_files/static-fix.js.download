$(document).ready(function () {
  var currentUrl = window.location.href;
  var governanceLetterPath =
    "/en/about/governance/global-impact-report/global-report-letter-from-global-ceo-chair";

  if (currentUrl.indexOf(governanceLetterPath) !== -1) {
    $(".cmp-list-image-v2--column .title-v2.font-size__xs").css({
      margin: "0",
      display: "contents",
    });
    $(".cmp-list-image-v2--column .title-v2.font-size__xs .cmp-title__text").css(
      "font-weight",
      "600"
    );
  }
});

